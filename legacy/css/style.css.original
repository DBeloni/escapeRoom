/* Estilo inicial de todos os elementos. */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

/* Remove a rolagem da página do jogo. */
body {
    overflow: hidden;
    background: #111;
    font-family: Arial, Helvetica, sans-serif;
}

/* Ocupa a janela inteira. dvh acompanha a barra do navegador no celular. */
#gameContainer {
    position: relative;
    width: 100vw;
    height: 100vh; /* Alternativa para navegadores sem suporte a dvh. */
    height: 100dvh;
    overflow: hidden;
    background: #000;
}

/* A tela de desenho ocupa toda a área do jogo. */
#gameCanvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
}

/* As mensagens ficam por cima da tela do jogo. */
#controls, #loading {
    position: absolute;
    color: #fff;
    background: rgba(0, 0, 0, .7);
    border-radius: 5px;
}

#controls {
    left: 12px;
    bottom: 12px;
    padding: 8px 12px;
    font-size: 12px;
    line-height: 18px;
    pointer-events: none;
}

/* Posiciona o aviso de carregamento no centro da tela. */
#loading {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 15px 25px;
}

/* Em telas pequenas, os controles ficam mais compactos. */
@media (max-width: 700px) {
    #controls {
        padding: 6px 8px;
        font-size: 10px;
    }
}
